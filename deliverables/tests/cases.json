{
  "_doc": [
    "Phase 5 common test cases. The same inputs are executed on PUB400 (5250), Java Web and iPad.",
    "All environments start from the common baseline (VOTINGDB: badges 1,28 / GUESTBKDB: comments 1,2 / ALWVOTE=Y).",
    "flow=vote      : ADDVOTE.  launch ASHIBATA = VCFMAIN 11 (exhibit protected, prefilled); launch MM2024 = shared terminal (exhibit open).",
    "flow=gb_add    : ADDGBCMT. launch ASHIBATA = VCFMAIN 12; MM2024 = shared terminal.",
    "flow=gb_read   : READGBCMT. launch ASHIBATA = VCFMAIN 13; DEMO400/MM2024 = launched for that profile.",
    "flow=learn     : LRN400 from VCFMAIN 1, then the listed keys.",
    "flow=kiosk     : EXHBMENU for the exhibit; optional option/password; observed = visible options + final screen sequence.",
    "pre/post       : DB operations executed in every environment before/after the case (setting / visible).",
    "expect.screen  : VOTE1 VOTEEND ENDOFCON ADDCMT ENDCMT READCMT LRN400 KIOSK ADMPSWRD NTRSTIT VCFMAIN",
    "expect.db      : vote -> VOTINGDB row for the badge (null = none); comment -> GUESTBKDB row for the id (null = none)"
  ],
  "cases": [
    {"id": "CV-01", "group": "ADDVOTE", "flow": "vote", "launch": "ASHIBATA", "title": "全項目未入力 (展示 ID は保護・事前入力)", "rules": ["V-01", "V-02", "B-05", "L-03-03"],
     "in": {"badge": "", "award": ""}, "expect": {"screen": "VOTE1", "errline": "Must enter Award ID", "vote": null}},
    {"id": "CV-02", "group": "ADDVOTE", "flow": "vote", "launch": "ASHIBATA", "title": "アワード未入力", "rules": ["V-02"],
     "in": {"badge": "7001", "award": ""}, "expect": {"screen": "VOTE1", "errline": "Must enter Award ID", "vote": null}},
    {"id": "CV-03", "group": "ADDVOTE", "flow": "vote", "launch": "ASHIBATA", "title": "バッジ未入力", "rules": ["V-01"],
     "in": {"badge": "", "award": "1"}, "expect": {"screen": "VOTE1", "errline": "Must enter badge number", "vote": null}},
    {"id": "CV-04", "group": "ADDVOTE", "flow": "vote", "launch": "ASHIBATA", "title": "正常投票 (新規バッジ 7001, アワード 1)", "rules": ["B-04", "V-08", "L-03-11"],
     "in": {"badge": "7001", "award": "1"}, "expect": {"screen": "VOTEEND", "vote": {"badge": 7001, "award": 1, "exhibit": "ASHIBATA"}}},
    {"id": "CV-05", "group": "ADDVOTE", "flow": "vote", "launch": "ASHIBATA", "title": "重複バッジ (7001 で再投票)", "rules": ["B-01", "V-04"],
     "in": {"badge": "7001", "award": "2"}, "expect": {"screen": "VOTE1", "errline": "You have already voted.", "vote": {"badge": 7001, "award": 1, "exhibit": "ASHIBATA"}}},
    {"id": "CV-06", "group": "ADDVOTE", "flow": "vote", "launch": "ASHIBATA", "title": "存在しないアワード (9)", "rules": ["V-07"],
     "in": {"badge": "7002", "award": "9"}, "expect": {"screen": "VOTE1", "errline": "Award does not exist.", "vote": null}},
    {"id": "CV-07", "group": "ADDVOTE", "flow": "vote", "launch": "ASHIBATA", "title": "境界値: アワード 0 (数値 0 = 未入力扱い)", "rules": ["B-15", "V-02"],
     "in": {"badge": "7002", "award": "0"}, "expect": {"screen": "VOTE1", "errline": "Must enter Award ID", "vote": null}},
    {"id": "CV-08", "group": "ADDVOTE", "flow": "vote", "launch": "MM2024", "title": "共用端末: 展示 ID 未入力", "rules": ["V-03", "B-13"],
     "in": {"badge": "7002", "exhibit": "", "award": "1"}, "expect": {"screen": "VOTE1", "errline": "Must enter Exhibit ID", "vote": null}},
    {"id": "CV-09", "group": "ADDVOTE", "flow": "vote", "launch": "MM2024", "title": "共用端末: 存在しない展示 NOSUCH", "rules": ["V-06"],
     "in": {"badge": "7002", "exhibit": "NOSUCH", "award": "1"}, "expect": {"screen": "VOTE1", "errline": "Exhibit does not exist", "vote": null}},
    {"id": "CV-10", "group": "ADDVOTE", "flow": "vote", "launch": "MM2024", "title": "共用端末: 資格外展示 NOVOTE (ELIGIBLE=0)", "rules": ["B-02", "V-05"],
     "in": {"badge": "7002", "exhibit": "NOVOTE", "award": "1"}, "expect": {"screen": "VOTE1", "errline": "Exhibit ineligible for award", "vote": null}},
    {"id": "CV-11", "group": "ADDVOTE", "flow": "vote", "launch": "MM2024", "title": "共用端末: 正常投票 (7002, DEMO400, アワード 2)", "rules": ["B-04", "B-13"],
     "in": {"badge": "7002", "exhibit": "DEMO400", "award": "2"}, "expect": {"screen": "VOTEEND", "vote": {"badge": 7002, "award": 2, "exhibit": "DEMO400"}}},
    {"id": "CV-12", "group": "ADDVOTE", "flow": "vote", "launch": "MM2024", "title": "複合エラー (重複バッジ+存在しない展示+存在しないアワード) → 最後の検査が勝つ", "rules": ["B-05"],
     "in": {"badge": "7001", "exhibit": "NOSUCH", "award": "9"}, "expect": {"screen": "VOTE1", "errline": "Award does not exist.", "vote": {"badge": 7001, "award": 1, "exhibit": "ASHIBATA"}}},
    {"id": "CV-13", "group": "ADDVOTE", "flow": "vote", "launch": "ASHIBATA", "title": "投票停止 ALWVOTE='N' → ENDOFCON", "rules": ["B-03", "V-09", "L-04-02"],
     "pre": [{"op": "setting", "name": "ALWVOTE", "value": "N"}], "post": [{"op": "setting", "name": "ALWVOTE", "value": "Y"}],
     "in": {"badge": "7003", "award": "1"}, "expect": {"screen": "ENDOFCON", "vote": null}},

    {"id": "CV-14", "group": "ADDGBCMT", "flow": "gb_add", "launch": "ASHIBATA", "title": "全項目未入力 (展示 ID は保護・事前入力)", "rules": ["V-11", "V-12", "B-05"],
     "in": {"name": "", "comment": ""}, "expect": {"screen": "ADDCMT", "errline": "Must enter a comment", "comment": {"id": 3, "row": null}}},
    {"id": "CV-15", "group": "ADDGBCMT", "flow": "gb_add", "launch": "ASHIBATA", "title": "コメント未入力", "rules": ["V-12"],
     "in": {"name": "Devin Tester", "comment": ""}, "expect": {"screen": "ADDCMT", "errline": "Must enter a comment", "comment": {"id": 3, "row": null}}},
    {"id": "CV-16", "group": "ADDGBCMT", "flow": "gb_add", "launch": "ASHIBATA", "title": "名前未入力", "rules": ["V-11"],
     "in": {"name": "", "comment": "Hello"}, "expect": {"screen": "ADDCMT", "errline": "Must enter your name", "comment": {"id": 3, "row": null}}},
    {"id": "CV-17", "group": "ADDGBCMT", "flow": "gb_add", "launch": "ASHIBATA", "title": "正常記入 → ENDCMT, CMTID=3 (最終+1), VISIBLE=Y", "rules": ["B-06", "L-07-08", "L-08-01"],
     "in": {"name": "Devin Tester", "comment": "Cross validation run"},
     "expect": {"screen": "ENDCMT", "comment": {"id": 3, "row": {"id": 3, "visible": "Y", "exhibit": "ASHIBATA", "name": "Devin Tester", "comment": "Cross validation run"}}}},
    {"id": "CV-18", "group": "ADDGBCMT", "flow": "gb_add", "launch": "MM2024", "title": "共用端末: 展示 ID 未入力", "rules": ["V-10"],
     "in": {"name": "Guest", "exhibit": "", "comment": "x"}, "expect": {"screen": "ADDCMT", "errline": "Must enter Exhibit ID", "comment": {"id": 4, "row": null}}},
    {"id": "CV-19", "group": "ADDGBCMT", "flow": "gb_add", "launch": "MM2024", "title": "共用端末: 存在しない展示 NOSUCH でも記入できる (存在チェックなし)", "rules": ["V-13"],
     "in": {"name": "Guest", "exhibit": "NOSUCH", "comment": "Unchecked exhibit"},
     "expect": {"screen": "ENDCMT", "comment": {"id": 4, "row": {"id": 4, "visible": "Y", "exhibit": "NOSUCH", "name": "Guest", "comment": "Unchecked exhibit"}}}},

    {"id": "CV-20", "group": "READGBCMT", "flow": "gb_read", "launch": "ASHIBATA", "title": "コメント ID 未入力", "rules": ["V-14"],
     "in": {"cmtid": ""}, "expect": {"screen": "READCMT", "errline": "Must enter CommentID"}},
    {"id": "CV-21", "group": "READGBCMT", "flow": "gb_read", "launch": "ASHIBATA", "title": "ID 1 → 名前 11 桁 / 展示タイトル / コメント", "rules": ["V-15", "L-09-05"],
     "in": {"cmtid": "1"}, "expect": {"screen": "READCMT", "total": 4, "out": {"name": "Great exhib", "title": "IBM i on PUB400 Demo", "cmt": "VCF/400 running on PUB400."}}},
    {"id": "CV-22", "group": "READGBCMT", "flow": "gb_read", "launch": "ASHIBATA", "title": "ID 3 (この実行で追加したコメント)", "rules": ["B-06"],
     "in": {"cmtid": "3"}, "expect": {"screen": "READCMT", "total": 4, "out": {"name": "Devin Teste", "title": "IBM i on PUB400 Demo", "cmt": "Cross validation run"}}},
    {"id": "CV-23", "group": "READGBCMT", "flow": "gb_read", "launch": "ASHIBATA", "title": "存在しない ID 9999 → 最終レコード (4, 他展示) → 帰属外メッセージ", "rules": ["B-09", "B-08", "V-18"],
     "in": {"cmtid": "9999"}, "expect": {"screen": "READCMT", "total": 4, "out": {"name": "", "title": "", "cmt": "This comment is not part of this guestbook."}}},
    {"id": "CV-24", "group": "READGBCMT", "flow": "gb_read", "launch": "ASHIBATA", "title": "非表示コメント (ID 2 を VISIBLE=N)", "rules": ["B-07", "V-16"],
     "pre": [{"op": "visible", "id": 2, "value": "N"}], "post": [{"op": "visible", "id": 2, "value": "Y"}],
     "in": {"cmtid": "2"}, "expect": {"screen": "READCMT", "total": 4, "out": {"name": "Name Hidden", "title": "", "cmt": "This comment hidden by an admin - offensive content."}}},
    {"id": "CV-25", "group": "READGBCMT", "flow": "gb_read", "launch": "DEMO400", "title": "他展示 (DEMO400) から ASHIBATA のコメント 1 を読む → 帰属外", "rules": ["B-08", "V-17"],
     "in": {"cmtid": "1"}, "expect": {"screen": "READCMT", "total": 4, "out": {"name": "", "title": "", "cmt": "This comment is not part of this guestbook."}}},
    {"id": "CV-26", "group": "READGBCMT", "flow": "gb_read", "launch": "MM2024", "title": "共用端末は全展示を閲覧可 / 展示タイトルは SETLL+READ (NOSUCH → NOVOTE)", "rules": ["B-08", "B-09"],
     "in": {"cmtid": "4"}, "expect": {"screen": "READCMT", "total": 4, "out": {"name": "Guest", "title": "Ineligible test exhibit (ELIGIBLE=0)", "cmt": "Unchecked exhibit"}}},

    {"id": "CV-27", "group": "LRN400", "flow": "learn", "launch": "ASHIBATA", "title": "F5 → 2 ページ目", "rules": ["V-19", "L-10-04"],
     "in": {"keys": ["F5"]}, "expect": {"screen": "LRN400", "page": 2, "content": "The AS/400 was introduced by IBM in June 1988 ... page 2"}},
    {"id": "CV-28", "group": "LRN400", "flow": "learn", "launch": "ASHIBATA", "title": "F5, F8 → 1 ページ目に戻る", "rules": ["V-20"],
     "in": {"keys": ["F5", "F8"]}, "expect": {"screen": "LRN400", "page": 1, "content": "Welcome to LEARN/400! This is page 1. Press F5 for next page, F8 for previous, F3 to exit."}},
    {"id": "CV-29", "group": "LRN400", "flow": "learn", "launch": "ASHIBATA", "title": "F5, F5 → 3 ページ目 (EXTRA='END') で終了 → VCFMAIN", "rules": ["B-10"],
     "in": {"keys": ["F5", "F5"]}, "expect": {"screen": "VCFMAIN"}},
    {"id": "CV-30", "group": "LRN400", "flow": "learn", "launch": "ASHIBATA", "title": "F3 → 終了 → VCFMAIN", "rules": ["V-21"],
     "in": {"keys": ["F3"]}, "expect": {"screen": "VCFMAIN"}},

    {"id": "CV-31", "group": "EXHBMENU", "flow": "kiosk", "exhibit": "ASHIBATA", "title": "ASHIBATA (ELIGIBLE=1, ENLRN400=1) → 1,2,3,4", "rules": ["L-05-04", "B-02", "B-12"],
     "in": {}, "expect": {"screen": "KIOSK", "options": ["1", "2", "3", "4"]}},
    {"id": "CV-32", "group": "EXHBMENU", "flow": "kiosk", "exhibit": "NOVOTE", "title": "NOVOTE (ELIGIBLE=0, ENLRN400=0) → 3,4 のみ", "rules": ["B-02", "B-12"],
     "in": {}, "expect": {"screen": "KIOSK", "options": ["3", "4"]}},
    {"id": "CV-33", "group": "EXHBMENU", "flow": "kiosk", "exhibit": "DEMO400", "title": "DEMO400 (ELIGIBLE=1, ENLRN400=0) → 1,3,4", "rules": ["B-12"],
     "in": {}, "expect": {"screen": "KIOSK", "options": ["1", "3", "4"]}},
    {"id": "CV-34", "group": "EXHBMENU", "flow": "kiosk", "exhibit": "ASHIBATA", "title": "隠しオプション 7 + 誤パスワード → キオスクメニューに戻る", "rules": ["B-11", "L-06-03"],
     "in": {"option": "7", "password": "WRONGPW"}, "expect": {"screen": "KIOSK", "options": ["1", "2", "3", "4"], "path": ["ADMPSWRD", "KIOSK"]}},
    {"id": "CV-35", "group": "EXHBMENU", "flow": "kiosk", "exhibit": "ASHIBATA", "title": "隠しオプション 7 + 正パスワード (SETTINGS.ADMPSWRD) → キオスク終了 → VCFMAIN", "rules": ["B-11", "L-05-06"],
     "in": {"option": "7", "password": "VCF2024"}, "expect": {"screen": "VCFMAIN", "options": ["1", "2", "3", "4"], "path": ["ADMPSWRD", "VCFMAIN"]}},
    {"id": "CV-36", "group": "EXHBMENU", "flow": "kiosk", "exhibit": "ASHIBATA", "title": "オプション 1 → NTRSTIT → VOTE1 (展示 ASHIBATA 固定) → F12 でキオスクへ戻る", "rules": ["L-05-08", "L-02-04", "B-13"],
     "in": {"option": "1"}, "expect": {"screen": "KIOSK", "options": ["1", "2", "3", "4"], "path": ["NTRSTIT", "VOTE1", "KIOSK"], "exhibit": "ASHIBATA"}},
    {"id": "CV-37", "group": "EXHBMENU", "flow": "kiosk", "exhibit": "NOVOTE", "title": "資格外展示でオプション 1 を入力 → 無視 (キオスクメニューのまま)", "rules": ["B-02", "L-05-04"],
     "in": {"option": "1"}, "expect": {"screen": "KIOSK", "options": ["3", "4"], "path": ["KIOSK"]}}
  ]
}
